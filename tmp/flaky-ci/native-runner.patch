@@ -0,0 +1,57 @@
+name: Diagnose Ruby 3.0 CI timeouts
+
+on:
+  push:
+    branches: [ci/flake-repro]
+
+permissions:
+  contents: read
+
+jobs:
+  diagnose-ruby-3-0:
+    runs-on: ubuntu-24.04
+    timeout-minutes: 30
+    env:
+      CI: '1'
+      REPEAT: '1000'
+      LOAD_WORKERS: '0'
+      TEST_NAMES: test_get_content
+      HTTPCLIENT_PROJECT_ROOT: ${{ github.workspace }}/subject
+      NO_TIMING: '0'
+      TRACE_TIMEOUT_RAISES: '1'
+    steps:
+      - uses: actions/checkout@v7
+      - uses: actions/checkout@v7
+        with:
+          ref: b6a8126a34dca1fbb07c360bd2c71d2915e0d17c
+          path: subject
+      - name: Restore failed job dependency snapshot
+        run: cp script/ci-flake/locks/ruby-3.0.lock subject/Gemfile.lock
+      - uses: ruby/setup-ruby@v1
+        id: ruby
+        with:
+          ruby-version: '3.0.7'
+          bundler: '2.2.33'
+          working-directory: subject
+          bundler-cache: true
+      - name: Record environment
+        run: |
+          mkdir -p evidence
+          {
+            uname -a
+            lscpu
+            git -C subject rev-parse HEAD
+            sha256sum subject/Gemfile.lock
+            cat subject/Gemfile.lock
+          } | tee evidence/environment.log
+      - name: Repeat with timeout instrumentation
+        run: |
+          set -o pipefail
+          bundle exec ruby -w --enable-frozen-string-literal --debug-frozen-string-literal \
+            -Ilib ../script/ci-flake/loaded-repeat.rb 2>&1 | tee ../evidence/instrumented.log
+      - uses: actions/upload-artifact@v4
+        if: ${{ !cancelled() && (success() || failure()) }}
+        with:
+          name: timeout-diagnostics-ruby-3.0
+          path: evidence/
+          retention-days: 14
diff --git a/.github/workflows/flake-repro.yml b/.github/workflows/flake-repro.yml
new file mode 100644
index 0000000..02dff3e
--- /dev/null
+++ b/.github/workflows/flake-repro.yml
@@ -0,0 +1,102 @@
+name: Reproduce CI timeouts
+
+on:
+  push:
+    branches: [ci/flake-repro]
+    paths:
+      - 'script/ci-flake/**'
+  workflow_dispatch:
+    inputs:
+      repetitions:
+        description: Repetitions of the selected test sequence
+        default: '1000'
+        required: true
+      load_workers:
+        description: Independent CPU competitors (0 for a control run)
+        type: choice
+        options: ['0', '2', '4']
+        default: '0'
+
+permissions:
+  contents: read
+
+jobs:
+  repeat:
+    runs-on: ubuntu-24.04
+    timeout-minutes: 20
+    strategy:
+      fail-fast: false
+      matrix:
+        include:
+          - ruby: '2.5.9'
+            lock: '2.5'
+            bundler: '2.3.27'
+            source: b6a8126a34dca1fbb07c360bd2c71d2915e0d17c
+            tests: test_empty_proxy_env,test_eof_error_length,test_eof_error_rest
+          - ruby: '2.6.10'
+            lock: '2.6'
+            bundler: '2.4.22'
+            source: 7062fd252c7db0c66b76ba8662043864dbdb52bb
+            tests: test_empty_proxy_env,test_eof_error_length,test_eof_error_rest
+          - ruby: '3.0.7'
+            lock: '3.0'
+            bundler: '2.2.33'
+            source: b6a8126a34dca1fbb07c360bd2c71d2915e0d17c
+            tests: test_get_content
+    env:
+      CI: '1'
+      REPEAT: ${{ inputs.repetitions || '1000' }}
+      LOAD_WORKERS: ${{ inputs.load_workers || '0' }}
+      TEST_NAMES: ${{ matrix.tests }}
+      HTTPCLIENT_PROJECT_ROOT: ${{ github.workspace }}/subject
+    steps:
+      - uses: actions/checkout@v7
+      - uses: actions/checkout@v7
+        with:
+          ref: ${{ matrix.source }}
+          path: subject
+      - name: Restore failed job dependency snapshot
+        env:
+          LOCK_VERSION: ${{ matrix.lock }}
+        run: cp "script/ci-flake/locks/ruby-$LOCK_VERSION.lock" subject/Gemfile.lock
+      - uses: ruby/setup-ruby@v1
+        id: ruby
+        with:
+          ruby-version: ${{ matrix.ruby }}
+          bundler: ${{ matrix.bundler }}
+          working-directory: subject
+          bundler-cache: true
+      - name: Record environment
+        run: |
+          mkdir -p evidence
+          {
+            uname -a
+            lscpu
+            git -C subject rev-parse HEAD
+            sha256sum subject/Gemfile.lock
+            cat subject/Gemfile.lock
+          } | tee evidence/environment.log
+      - name: Repeat without timeout instrumentation
+        working-directory: subject
+        env:
+          NO_TIMING: '1'
+        run: |
+          set -o pipefail
+          bundle exec ruby -w --enable-frozen-string-literal --debug-frozen-string-literal \
+            -Ilib ../script/ci-flake/loaded-repeat.rb 2>&1 | tee ../evidence/control.log
+      - name: Repeat with timeout instrumentation
+        if: ${{ !cancelled() && steps.ruby.outcome == 'success' }}
+        working-directory: subject
+        env:
+          NO_TIMING: '0'
+          TRACE_TIMEOUT_RAISES: '1'
+        run: |
+          set -o pipefail
+          bundle exec ruby -w --enable-frozen-string-literal --debug-frozen-string-literal \
+            -Ilib ../script/ci-flake/loaded-repeat.rb 2>&1 | tee ../evidence/instrumented.log
+      - uses: actions/upload-artifact@v4
+        if: ${{ !cancelled() && (success() || failure()) }}
+        with:
+          name: timeout-evidence-ruby-${{ matrix.ruby }}
+          path: evidence/
+          retention-days: 14
diff --git a/script/ci-flake/loaded-repeat.rb b/script/ci-flake/loaded-repeat.rb
new file mode 100644
index 0000000..344acc8
--- /dev/null
+++ b/script/ci-flake/loaded-repeat.rb
@@ -0,0 +1,34 @@
+# Independent CPU competitors, with cleanup even when repeat.rb exits on failure.
+# They share the container's CPU quota but do not change the timeout or server.
+workers = Integer(ENV.fetch('LOAD_WORKERS', '0'))
+abort 'LOAD_WORKERS must be between 0 and 16' unless (0..16).include?(workers)
+pids = []
+stats = ['/sys/fs/cgroup/cpu.max', '/sys/fs/cgroup/cpu.stat',
+         '/sys/fs/cgroup/memory.events']
+snapshot = lambda do |label|
+  stats.each do |path|
+    puts "#{label} #{path}: #{File.read(path).strip}" if File.readable?(path)
+  end
+end
+$stdout.sync = true
+puts "load_workers=#{workers} uname=#{`uname -a`.strip}"
+snapshot.call('before')
+begin
+  workers.times do
+    pids << fork do
+      # Ruby arithmetic consumes CPU without allocating an unbounded data set.
+      value = 0
+      loop { value = (value + 1) % 1_000_003 }
+    end
+  end
+  load File.join(__dir__, 'repeat.rb')
+ensure
+  pids.each do |pid|
+    begin
+      Process.kill('TERM', pid)
+    rescue Errno::ESRCH
+    end
+  end
+  pids.each { |pid| Process.wait(pid) }
+  snapshot.call('after')
+end
